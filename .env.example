# ==========================================
# IntelliBank Environment Configuration
# ==========================================

# Groq API Key (Get a free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model (Default: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model (Sentence Transformers HuggingFace ID)
EMBEDDING_MODEL=all-MiniLM-L6-v2
